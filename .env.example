# Copie para .env e ajuste. Nunca commite o .env.
POSTGRES_USER=fisio
POSTGRES_PASSWORD=fisio_dev_password
POSTGRES_DB=fisio_orto_sport
POSTGRES_PORT=5432

DATABASE_URL="postgresql://fisio:fisio_dev_password@localhost:5432/fisio_orto_sport?schema=public"

# Primeiro Administrador, criado por `pnpm db:seed` (idempotente: não altera um usuário existente).
# Use uma senha forte (mínimo de 8 caracteres) e troque os placeholders antes de rodar.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Primeiro acesso pela tela de login (só com a tabela de usuários vazia). Sem esta variável, ou com
# menos de 32 caracteres, o cadastro do primeiro Administrador pela web fica desligado.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Remova depois do primeiro cadastro. Nunca commite o valor real.
# SETUP_TOKEN=""

# Autenticação: não há AUTH_SECRET. A sessão usa um token aleatório (32 bytes) em cookie httpOnly;
# o banco guarda apenas o hash SHA-256 do token.

# Testes de integração (`pnpm test:integration`): use um banco DESCARTÁVEL, já migrado
# (`DATABASE_URL=<esta url> pnpm exec prisma migrate deploy`). Nunca aponte para dev/produção.
# INTEGRATION_DATABASE_URL="postgresql://fisio:fisio_dev_password@localhost:5432/fisio_orto_sport_test?schema=public"
