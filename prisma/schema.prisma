// Schema Prisma do TechLab+ Fisio OrtoSport.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso. As permissões de cada perfil ficam em src/modules/auth/permissions.ts.
enum Role {
  ADMIN
  RECEPCAO
  FISIOTERAPEUTA
}

model User {
  id                              String                    @id @default(cuid())
  name                            String
  // Sempre gravado normalizado (trim + minúsculas).
  email                           String                    @unique
  passwordHash                    String
  role                            Role
  // Registro no conselho (CREFITO). Obrigatório no formulário para FISIOTERAPEUTA; nulo nos
  // demais perfis. Texto curto normalizado (trim + maiúsculas), único quando informado.
  crefito                         String?                   @unique @db.VarChar(20)
  active                          Boolean                   @default(true)
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  sessions                        Session[]
  patientsCreated                 Patient[]                 @relation("PatientCreatedBy")
  patientsUpdated                 Patient[]                 @relation("PatientUpdatedBy")
  // Agenda: o próprio usuário FISIOTERAPEUTA ativo é o profissional atendente.
  appointmentsAsProfessional      Appointment[]             @relation("AppointmentProfessional")
  appointmentsCreated             Appointment[]             @relation("AppointmentCreatedBy")
  appointmentsUpdated             Appointment[]             @relation("AppointmentUpdatedBy")
  appointmentsCancelled           Appointment[]             @relation("AppointmentCancelledBy")
  anamnesesAuthored               Anamnesis[]
  assessmentsAuthored             Assessment[]
  assessmentChangesAuthored       AssessmentChange[]
  therapyPlansAuthored            TherapyPlan[]
  planRevisionsAuthored           TherapyPlanRevision[]
  planStatusChangesAuthored       TherapyPlanStatusChange[]
  // Atendimento clínico (TreatmentSession) não é a sessão de autenticação (Session).
  treatmentSessionsAsProfessional TreatmentSession[]        @relation("TreatmentSessionProfessional")
  treatmentSessionsAuthored       TreatmentSession[]        @relation("TreatmentSessionAuthor")
  treatmentSessionsInvalidated    TreatmentSession[]        @relation("TreatmentSessionInvalidatedBy")
  treatmentSessionChangesAuthored TreatmentSessionChange[]
}

// Sessão no banco: o cookie guarda um token aleatório; aqui fica só o hash SHA-256 dele.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PatientStatus {
  ATIVO
  INATIVO
}

// Opções definidas pela clínica (Fase 2c).
enum Sex {
  FEMININO
  MASCULINO
  NAO_INFORMADO
}

// Cadastro do paciente: SOMENTE dados cadastrais e de contato. Dados clínicos (anamnese,
// avaliações, sessões) ficam em entidades próprias, protegidas por `clinico:*`.
// Não há exclusão física; futuras relações com Patient devem usar onDelete: Restrict.
model Patient {
  id                   String             @id @default(cuid())
  fullName             String
  // Nome sem acentos e em minúsculas, para a busca. Mantido pelo trigger "Patient_search_name"
  // (ver migração busca_sem_acento): a aplicação nunca grava este campo.
  searchName           String             @default("")
  birthDate            DateTime           @db.Date
  // Fase 2c. Obrigatório no formulário; nulo apenas em cadastros anteriores à 2c.
  sex                  Sex?
  occupation           String?            @db.VarChar(120)
  // Só os 11 dígitos. Único quando informado (o Postgres aceita vários NULL).
  cpf                  String?            @unique
  // Só dígitos (DDD + número).
  phone                String
  email                String?
  address              String?
  status               PatientStatus      @default(ATIVO)
  // Observações administrativas; nunca conteúdo clínico.
  notes                String?
  // Responsável legal: obrigatório (nome e telefone) para menores de 18 anos; nulo para adultos.
  guardianName         String?
  guardianPhone        String?
  guardianRelationship String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdById          String
  updatedById          String
  createdBy            User               @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User               @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  appointments         Appointment[]
  anamneses            Anamnesis[]
  assessments          Assessment[]
  therapyPlans         TherapyPlan[]
  treatmentSessions    TreatmentSession[]

  @@index([fullName])
  @@index([status, fullName])
}

enum AppointmentStatus {
  AGENDADO
  CANCELADO
}

// Agendamento. Não há exclusão física: cancelar muda o status e preserva o registro.
// Sobreposição para o mesmo profissional é barrada na action e, no banco, pela constraint
// de exclusão "Appointment_no_overlap" (btree_gist, intervalo [início, fim), só AGENDADO).
model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  professionalId String
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(AGENDADO)
  // Observação administrativa; nunca conteúdo clínico.
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledById  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String
  updatedById    String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional   User              @relation("AppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User              @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cancelledBy    User?             @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
}

enum PainType {
  PONTADA
  QUEIMACAO
  PESO
  IRRADIADA
}

// Anamnese (dado clínico sensível, protegido por `clinico:*`). Versionamento append-only:
// cada salvamento cria uma nova linha imutável; não há update nem exclusão.
// Versão vigente: maior createdAt, desempate pelo maior id. assessmentDate é a data clínica
// informada e não define a versão vigente. authorNameSnapshot preserva a assinatura histórica.
// CHECKs manuais na migração (não representados aqui): painIntensity entre 0 e 10 e
// chiefComplaint não vazia.
model Anamnesis {
  id                          String       @id @default(cuid())
  patientId                   String
  authorId                    String
  authorNameSnapshot          String       @db.VarChar(120)
  assessmentDate              DateTime     @db.Date
  chiefComplaint              String       @db.VarChar(500)
  currentIllnessHistory       String?      @db.VarChar(4000)
  personalPathologicalHistory String?      @db.VarChar(4000)
  surgeries                   String?      @db.VarChar(2000)
  currentMedications          String?      @db.VarChar(2000)
  habitsPhysicalActivity      String?      @db.VarChar(2000)
  painIntensity               Int?         @db.SmallInt
  painLocation                String?      @db.VarChar(200)
  painTypes                   PainType[]   @default([])
  functionalLimitations       String?      @db.VarChar(2000)
  patientGoals                String?      @db.VarChar(2000)
  clinicalNotes               String?      @db.VarChar(4000)
  createdAt                   DateTime     @default(now()) @db.Timestamptz(3)
  patient                     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author                      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  assessments                 Assessment[]

  // Alvo da FK composta de Assessment: a anamnese de referência é sempre do mesmo paciente.
  @@unique([id, patientId])
  @@index([patientId])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
}

// Avaliação fisioterapêutica inicial (Fase 4, dado clínico sensível, protegido por `clinico:*`).
// Editável, com histórico por campo em AssessmentChange (decisão D2). Não há exclusão.
// A anamnese de referência é fixada na criação e, pela FK composta (anamnesisId, patientId),
// sempre pertence ao mesmo paciente. `version` serve à checagem otimista de edições concorrentes.
// assessmentDate é a data clínica (não futura no calendário de America/Sao_Paulo); createdAt e
// updatedAt são técnicos. Autoria (nome e CREFITO) é snapshot do usuário no servidor (D1/D3).
// CHECKs manuais na migração (não representados aqui): diagnóstico e nome do autor não vazios,
// version >= 1.
model Assessment {
  id                    String             @id @default(cuid())
  patientId             String
  anamnesisId           String
  assessmentDate        DateTime           @db.Date
  inspection            String?            @db.VarChar(4000)
  palpation             String?            @db.VarChar(4000)
  functionalGait        String?            @db.VarChar(4000)
  rangeOfMotion         String?            @db.VarChar(4000)
  muscleStrength        String?            @db.VarChar(4000)
  specialTests          String?            @db.VarChar(4000)
  diagnosis             String             @db.VarChar(2000)
  therapeuticGoals      String?            @db.VarChar(2000)
  clinicalNotes         String?            @db.VarChar(4000)
  version               Int                @default(1)
  authorId              String
  authorNameSnapshot    String             @db.VarChar(120)
  authorCrefitoSnapshot String?            @db.VarChar(20)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @db.Timestamptz(3)
  patient               Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  anamnesis             Anamnesis          @relation(fields: [anamnesisId, patientId], references: [id, patientId], onDelete: Restrict)
  author                User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  changes               AssessmentChange[]
  therapyPlans          TherapyPlan[]

  // Alvo da FK composta de TherapyPlan: a avaliação de origem é sempre do mesmo paciente.
  @@unique([id, patientId])
  @@index([patientId, assessmentDate(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([anamnesisId, patientId])
  @@index([authorId])
}

// Histórico da avaliação: uma linha por campo alterado em cada edição (append-only).
// `version` é a versão da avaliação produzida pela edição; agrupa os campos de uma mesma edição.
// Valores guardados como texto (datas em AAAA-MM-DD); NULL = "não informado".
model AssessmentChange {
  id                    String     @id @default(cuid())
  assessmentId          String
  version               Int
  field                 String     @db.VarChar(40)
  previousValue         String?    @db.VarChar(4000)
  newValue              String?    @db.VarChar(4000)
  editorId              String
  editorNameSnapshot    String     @db.VarChar(120)
  editorCrefitoSnapshot String?    @db.VarChar(20)
  changedAt             DateTime   @default(now()) @db.Timestamptz(3)
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  editor                User       @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, version, field])
  @@index([editorId])
}

enum TherapyPlanStatus {
  ATIVO
  ENCERRADO
}

enum TherapyPlanRevisionKind {
  INICIAL
  CORRECAO
  MUDANCA_CLINICA
}

// Plano terapêutico (Fase 4, dado clínico sensível, protegido por `clinico:*`). Decorre de uma
// avaliação inicial do mesmo paciente (FK composta) e guarda a versão exata da avaliação usada
// (assessmentVersion). O conteúdo fica em revisões imutáveis (TherapyPlanRevision); a vigente é a
// de número currentRevision, que também serve à checagem otimista de revisões concorrentes.
// Vários planos por paciente. Estado ATIVO/ENCERRADO (encerrar não é alta clínica), com as
// mudanças registradas em TherapyPlanStatusChange. Não há exclusão.
// CHECKs manuais na migração: assessmentVersion >= 1, currentRevision >= 1, nome do autor não vazio.
model TherapyPlan {
  id                    String                    @id @default(cuid())
  patientId             String
  assessmentId          String
  assessmentVersion     Int
  status                TherapyPlanStatus         @default(ATIVO)
  currentRevision       Int                       @default(1)
  authorId              String
  authorNameSnapshot    String                    @db.VarChar(120)
  authorCrefitoSnapshot String?                   @db.VarChar(20)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                  @default(now()) @db.Timestamptz(3)
  patient               Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assessment            Assessment                @relation(fields: [assessmentId, patientId], references: [id, patientId], onDelete: Restrict)
  author                User                      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  revisions             TherapyPlanRevision[]
  statusChanges         TherapyPlanStatusChange[]
  treatmentSessions     TreatmentSession[]

  // Alvo da FK composta de TreatmentSession: o plano é sempre do mesmo paciente.
  @@unique([id, patientId])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([assessmentId, patientId])
  @@index([authorId])
}

// Revisão imutável do plano: o conteúdo completo em cada número (1 = INICIAL). Nunca é alterada;
// corrigir ou mudar o plano cria a revisão seguinte, com tipo e motivo. Sessões futuras apontarão
// para a revisão efetivamente usada. planDate é a data clínica da revisão (não futura em
// America/Sao_Paulo e não anterior à data da avaliação de origem); createdAt é técnico.
// CHECKs manuais na migração: number >= 1, INICIAL só no número 1 e sem motivo, demais com motivo,
// objetivos e conduta não vazios, plannedSessions entre 1 e 100 quando informado.
model TherapyPlanRevision {
  id                    String                  @id @default(cuid())
  planId                String
  number                Int
  kind                  TherapyPlanRevisionKind
  reason                String?                 @db.VarChar(500)
  planDate              DateTime                @db.Date
  goals                 String                  @db.VarChar(2000)
  conduct               String                  @db.VarChar(4000)
  techniques            String?                 @db.VarChar(4000)
  exercises             String?                 @db.VarChar(4000)
  plannedSessions       Int?                    @db.SmallInt
  frequency             String?                 @db.VarChar(200)
  reassessment          String?                 @db.VarChar(500)
  notes                 String?                 @db.VarChar(4000)
  authorId              String
  authorNameSnapshot    String                  @db.VarChar(120)
  authorCrefitoSnapshot String?                 @db.VarChar(20)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  plan                  TherapyPlan             @relation(fields: [planId], references: [id], onDelete: Restrict)
  author                User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  treatmentSessions     TreatmentSession[]

  @@unique([planId, number])
  // Alvo da FK composta de TreatmentSession: a revisão aplicada é sempre do mesmo plano.
  @@unique([id, planId])
  @@index([authorId])
}

// Encerramento e reabertura do plano, com motivo e assinatura. Append-only.
model TherapyPlanStatusChange {
  id                    String            @id @default(cuid())
  planId                String
  fromStatus            TherapyPlanStatus
  toStatus              TherapyPlanStatus
  reason                String            @db.VarChar(500)
  authorId              String
  authorNameSnapshot    String            @db.VarChar(120)
  authorCrefitoSnapshot String?           @db.VarChar(20)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  plan                  TherapyPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  author                User              @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([planId, createdAt])
  @@index([authorId])
}

enum TreatmentSessionStatus {
  VALIDO
  INVALIDADO
}

// Atendimento clínico (sessão de fisioterapia) com a evolução do paciente (Fase 4, dado clínico
// sensível, `clinico:*`). NÃO é a sessão de autenticação (Session) nem um agendamento: não há vínculo
// com Appointment nesta fatia. Aponta para o plano (mesmo paciente) e para a revisão exata aplicada
// (mesmo plano), por FKs compostas; novas revisões não mudam a referência.
// occurredAt é o momento clínico (não futuro; não antes do início do plano); createdAt é técnico.
// Responsável (professional*) é um FISIOTERAPEUTA, distinto do autor do lançamento (author*).
// Editável com histórico por campo (TreatmentSessionChange) e checagem otimista por `version`.
// Invalidação (lançado por engano) mantém o registro e o tira da contagem. Não há exclusão.
// idempotencyKey (gerada pelo formulário) impede que um reenvio crie o mesmo atendimento duas vezes.
// CHECKs manuais: evolução e nomes não vazios, version >= 1, invalidação coerente com o status.
model TreatmentSession {
  id                          String                   @id @default(cuid())
  patientId                   String
  planId                      String
  planRevisionId              String
  occurredAt                  DateTime                 @db.Timestamptz(3)
  professionalId              String
  professionalNameSnapshot    String                   @db.VarChar(120)
  professionalCrefitoSnapshot String?                  @db.VarChar(20)
  techniques                  String?                  @db.VarChar(4000)
  exercises                   String?                  @db.VarChar(4000)
  observations                String?                  @db.VarChar(4000)
  evolution                   String                   @db.VarChar(4000)
  nextSteps                   String?                  @db.VarChar(2000)
  status                      TreatmentSessionStatus   @default(VALIDO)
  invalidationReason          String?                  @db.VarChar(500)
  invalidatedAt               DateTime?                @db.Timestamptz(3)
  invalidatedById             String?
  invalidatedByNameSnapshot   String?                  @db.VarChar(120)
  version                     Int                      @default(1)
  idempotencyKey              String                   @unique @db.VarChar(64)
  authorId                    String
  authorNameSnapshot          String                   @db.VarChar(120)
  authorCrefitoSnapshot       String?                  @db.VarChar(20)
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                 @default(now()) @db.Timestamptz(3)
  patient                     Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  plan                        TherapyPlan              @relation(fields: [planId, patientId], references: [id, patientId], onDelete: Restrict)
  planRevision                TherapyPlanRevision      @relation(fields: [planRevisionId, planId], references: [id, planId], onDelete: Restrict)
  professional                User                     @relation("TreatmentSessionProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  author                      User                     @relation("TreatmentSessionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  invalidatedBy               User?                    @relation("TreatmentSessionInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  changes                     TreatmentSessionChange[]

  @@index([patientId, occurredAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([planId, status])
  @@index([planRevisionId, planId])
  @@index([professionalId])
  @@index([authorId])
  @@index([invalidatedById])
}

// Histórico do atendimento: uma linha por campo alterado em cada edição (append-only), com o motivo
// da correção. `version` é a versão do atendimento produzida pela edição.
model TreatmentSessionChange {
  id                    String           @id @default(cuid())
  sessionId             String
  version               Int
  field                 String           @db.VarChar(40)
  previousValue         String?          @db.VarChar(4000)
  newValue              String?          @db.VarChar(4000)
  reason                String           @db.VarChar(500)
  editorId              String
  editorNameSnapshot    String           @db.VarChar(120)
  editorCrefitoSnapshot String?          @db.VarChar(20)
  changedAt             DateTime         @default(now()) @db.Timestamptz(3)
  session               TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  editor                User             @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([sessionId, version, field])
  @@index([editorId])
}
