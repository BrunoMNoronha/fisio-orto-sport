// Schema Prisma do TechLab+ Fisio OrtoSport.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso. As permissões de cada perfil ficam em src/modules/auth/permissions.ts.
enum Role {
  ADMIN
  RECEPCAO
  FISIOTERAPEUTA
}

model User {
  id                         String        @id @default(cuid())
  name                       String
  // Sempre gravado normalizado (trim + minúsculas).
  email                      String        @unique
  passwordHash               String
  role                       Role
  active                     Boolean       @default(true)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  sessions                   Session[]
  patientsCreated            Patient[]     @relation("PatientCreatedBy")
  patientsUpdated            Patient[]     @relation("PatientUpdatedBy")
  // Agenda: o próprio usuário FISIOTERAPEUTA ativo é o profissional atendente.
  appointmentsAsProfessional Appointment[] @relation("AppointmentProfessional")
  appointmentsCreated        Appointment[] @relation("AppointmentCreatedBy")
  appointmentsUpdated        Appointment[] @relation("AppointmentUpdatedBy")
  appointmentsCancelled      Appointment[] @relation("AppointmentCancelledBy")
  anamnesesAuthored          Anamnesis[]
}

// Sessão no banco: o cookie guarda um token aleatório; aqui fica só o hash SHA-256 dele.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PatientStatus {
  ATIVO
  INATIVO
}

// Cadastro do paciente: SOMENTE dados cadastrais e de contato. Dados clínicos (anamnese,
// avaliações, sessões) ficam em entidades próprias, protegidas por `clinico:*`.
// Não há exclusão física; futuras relações com Patient devem usar onDelete: Restrict.
model Patient {
  id                   String        @id @default(cuid())
  fullName             String
  birthDate            DateTime      @db.Date
  // Só os 11 dígitos. Único quando informado (o Postgres aceita vários NULL).
  cpf                  String?       @unique
  // Só dígitos (DDD + número).
  phone                String
  email                String?
  address              String?
  status               PatientStatus @default(ATIVO)
  // Observações administrativas; nunca conteúdo clínico.
  notes                String?
  // Responsável legal: obrigatório (nome e telefone) para menores de 18 anos; nulo para adultos.
  guardianName         String?
  guardianPhone        String?
  guardianRelationship String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdById          String
  updatedById          String
  createdBy            User          @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User          @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  appointments         Appointment[]
  anamneses            Anamnesis[]

  @@index([fullName])
  @@index([status, fullName])
}

enum AppointmentStatus {
  AGENDADO
  CANCELADO
}

// Agendamento. Não há exclusão física: cancelar muda o status e preserva o registro.
// Sobreposição para o mesmo profissional é barrada na action e, no banco, pela constraint
// de exclusão "Appointment_no_overlap" (btree_gist, intervalo [início, fim), só AGENDADO).
model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  professionalId String
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(AGENDADO)
  // Observação administrativa; nunca conteúdo clínico.
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledById  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String
  updatedById    String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  professional   User              @relation("AppointmentProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User              @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cancelledBy    User?             @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([professionalId, startsAt])
  @@index([patientId, startsAt])
}

enum PainType {
  PONTADA
  QUEIMACAO
  PESO
  IRRADIADA
}

// Anamnese (dado clínico sensível, protegido por `clinico:*`). Versionamento append-only:
// cada salvamento cria uma nova linha imutável; não há update nem exclusão.
// Versão vigente: maior createdAt, desempate pelo maior id. assessmentDate é a data clínica
// informada e não define a versão vigente. authorNameSnapshot preserva a assinatura histórica.
// CHECKs manuais na migração (não representados aqui): painIntensity entre 0 e 10 e
// chiefComplaint não vazia.
model Anamnesis {
  id                          String     @id @default(cuid())
  patientId                   String
  authorId                    String
  authorNameSnapshot          String     @db.VarChar(120)
  assessmentDate              DateTime   @db.Date
  chiefComplaint              String     @db.VarChar(500)
  currentIllnessHistory       String?    @db.VarChar(4000)
  personalPathologicalHistory String?    @db.VarChar(4000)
  surgeries                   String?    @db.VarChar(2000)
  currentMedications          String?    @db.VarChar(2000)
  habitsPhysicalActivity      String?    @db.VarChar(2000)
  painIntensity               Int?       @db.SmallInt
  painLocation                String?    @db.VarChar(200)
  painTypes                   PainType[] @default([])
  functionalLimitations       String?    @db.VarChar(2000)
  patientGoals                String?    @db.VarChar(2000)
  clinicalNotes               String?    @db.VarChar(4000)
  createdAt                   DateTime   @default(now()) @db.Timestamptz(3)
  patient                     Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author                      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([patientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
}
